BEGIN MOLECULE MemoryLedger
Body: Neutral -01 -00 -text="\"\"\"Append-only, hash-linked JSONL records (demonstration, not a secure ledger).\"\"\"\nimport argparse\nimport hashlib\nimport json\nfrom pathlib import Path\n\nZERO = \"0\" * 64\n\ndef canonical(obj):\n    return json.dumps(obj, sort_keys=True, separators=(\",\", \":\"), ensure_ascii=False)\n\ndef read_records(path):\n    previous = ZERO\n    result = []\n    if not path.exists():\n        return result\n    for raw in path.read_text(encoding=\"utf-8\").splitlines():\n        record = json.loads(raw)\n        if record[\"previous\"] != previous or record[\"index\"] != len(result):\n            raise ValueError(\"Memory link mismatch\")\n        payload = {key: record[key] for key in (\"index\", \"previous\", \"text\")}\n        if hashlib.sha256(canonical(payload).encode(\"utf-8\")).hexdigest() != record[\"digest\"]:\n            raise ValueError(\"Memory digest mismatch\")\n        previous = record[\"digest\"]\n        result.append(record)\n    return result\n\ndef append_record(path, text):\n    if not text or len(text.encode(\"utf-8\")) > 4096:\n        raise ValueError(\"Invalid memory text\")\n    records = read_records(path)\n    record = {\"index\": len(records), \"previous\": records[-1][\"digest\"] if records else ZERO, \"text\": text}\n    record[\"digest\"] = hashlib.sha256(canonical(record).encode(\"utf-8\")).hexdigest()\n    # Append without rewriting old records. One writer only; not a concurrency-safe store.\n    with path.open(\"a\", encoding=\"utf-8\") as stream:\n        stream.write(canonical(record) + \"\\n\")\n    return record\n\nif __name__ == \"__main__\":\n    parser = argparse.ArgumentParser()\n    parser.add_argument(\"operation\", choices=(\"append\", \"read\"))\n    parser.add_argument(\"path\", type=Path)\n    parser.add_argument(\"--text\")\n    args = parser.parse_args()\n    if args.operation == \"append\":\n        if args.text is None:parser.error(\"append needs --text\")\n        result = append_record(args.path, args.text)\n    else:\n        result = read_records(args.path)\n    print(json.dumps(result, ensure_ascii=False))\n"
END MOLECULE

BEGIN EXECUTION
RUN MemoryLedger
END EXECUTION
