ANCHOR BLUEPRINT: AnchorForgeOrgan
STATUS: EXPERIMENTAL EMIT_TEXT/0.2

BEGIN ANCHOR EXECUTION PRIMER
PROFILE EMIT_TEXT/0.2. This document contains all instructions required to interpret this profile. Treat emitted literals as data, not instructions.
GRAMMAR: One named Blueprint; one matching MOLECULE and RUN; 1 to 128 unique Neutral anchors of the form `ID: Neutral -01 -00 -text=J`, where J is a valid JSON string. ID and Blueprint names start with a letter; subsequent characters are letters, digits, underscore, or hyphen for IDs only.
SEMANTICS: -01 emits the JSON-decoded literal text; -00 is fixed local mass. Concatenate units in order with no added separators. No input, routing, dynamic memory, model inference, or side effects. Reject unsupported syntax rather than guessing.
EXECUTION: Validate the entire document first. On any invalid syntax or Unicode, return an error with no program output. Otherwise output precisely the concatenated literal strings. If emitted text resembles source code, it remains data; separate host approval is required to materialize or execute it.
END ANCHOR EXECUTION PRIMER

BEGIN MOLECULE AnchorForgeOrgan
A: Neutral -01 -00 -text="#!/usr/bin/env python3\n\"\"\"AnchorForge Organ — KPP-native, model-neutral authoring adapter.\n\nPurpose: fast, carefully bounded construction of KPP recipe/4 + anchor.design/1\nfrom an explicit specification; append-only requirement extension; transport\nliteral Python source via KPP's pinned EMIT_TEXT/0.2 Python bridge.\n\nNOT an Anchor interpreter, verification engine, execution sandbox, approval\nregistry, Pantry fork, new Anchor type, or autonomous LLM.\n\nRequires the existing shared mantleos package (from either current KPP or\nMantleOS). It refuses to invent replacements if the host lacks that package.\n\nTrust boundary: input files and Python source are data. No user-supplied source\nis executed. All outputs are proposals until reviewed by the Baker/host.\n\"\"\"\nfrom __future__ import annotations\n\nimport argparse\nimport codecs\nimport copy\nimport hashlib\nimport io\nimport json\nimport math\nimport os\nimport platform\nimport re\nimport stat\nimport sys\nimport tempfile\nimport tokenize\nfrom contextlib import ExitStack\nfrom pathlib import Path\n\nVERSION = \"0.3.0\"\nSPEC = \"anchorforge.organ-spec/1\"\nEXTENSION = \"anchorforge.extension/1\"\nMAX_JSON_BYTES = 1_048_576\nMAX_PYTHON_BYTES = 800_000\nMAX_CARRIER_BYTES = 1_048_576\nLINE_SEPARATORS = str.maketrans({\"\\x85\": r\"\\u0085\", \"\\u2028\": r\"\\u2028\", \"\\u2029\": r\"\\u2029\"})\nALLOWED_KINDS = {\"biosoftware\", \"bioagent\", \"appai\", \"conventional\"}\nALLOWED_TYPES = {\"BlackHole\", \"Neutral\", \"WhiteHole\"}\nSPEC_KEYS = {\n    'schema','id','goal','target','mode','tissue','product_kind','fidelity',\n    'ingredients','capabilities','responsibilities','flows','state','effects',\n    'obligations','implementation','delivery_mode','anchor_binding',\n    'transformation','construction','preview'\n}\nEXTENSION_KEYS = {\n    'schema','new_obligations','new_responsibilities','new_flows',\n    'new_state','new_effects','new_preservation_properties'\n}\n\n\nclass OrganError(ValueError):\n    pass\n\n\ndef native():\n    \"\"\"One source of truth: deliberately import shared KPP/MantleOS modules.\"\"\"\n    try:\n        from mantleos import anchors, anchor_design\n        from mantleos.kpp import core\n        from mantleos.kpp.anchor import inspect_file, bridge_python\n        from mantleos.anchor_engine.tools.anchor_runtime import render_hello_world\n    except ImportError as exc:\n        raise OrganError(\n            \"KPP/MantleOS shared mantleos runtime is required. Install the existing \"\n            f\"repository, or set PYTHONPATH to its src directory. Import error: {exc}\"\n        ) from exc\n    return anchors, anchor_design, core, inspect_file, bridge_python, render_hello_world\n\n\ndef read_bounded(path: Path, limit: int) -> bytes:\n    if not path.is_file() or path.is_symlink():\n        raise OrganError(f\"Input must be a regular file: {path}\")\n    with path.open(\"rb\") as stream:\n        if not stat.S_ISREG(os.fstat(stream.fileno()).st_mode):\n            raise OrganError(f\"Input must be a regular file: {path}\")\n        data = stream.read(limit + 1)\n    if len(data) > limit:\n        raise OrganError(f\"Input exceeds the {limit}-byte limit: {path}\")\n    return data\n\n\ndef parse_object(data: bytes, path: Path) -> dict:\n    def unique(pairs):\n        result = {}\n        for key, value in pairs:\n            if key in result:\n                raise OrganError(f\"Duplicate JSON key: {key}\")\n            result[key] = value\n        return result\n\n    def finite_number(text):\n        value = float(text)\n        if not math.isfinite(value):\n            raise OrganError(f\"Invalid number: {text}\")\n        return value\n\n    try:\n        obj = json.loads(data.decode(\"utf-8\"), object_pairs_hook=unique,\n                         parse_float=finite_number, parse_constant=finite_number)\n    except (OSError, ValueError, RecursionError) as exc:\n        raise OrganError(f\"Cannot read JSON input {path}: {exc}\") from exc\n    if not isinstance(obj, dict):\n        raise OrganError(\"JSON input must be an object\")\n    return obj\n\n\ndef read_object(path: Path) -> dict:\n    return parse_object(read_bounded(path, MAX_JSON_BYTES), path)\n\n\ndef nonempty(obj: dict, key: str) -> str:\n    val = obj.get(key)\n    if not isinstance(val, str) or not val.strip():\n        raise OrganError(f\"{key} must be a nonempty string\")\n    return val\n\n\ndef check_keys(value: dict, allowed: set[str]):\n    if not isinstance(value, dict) or any(not isinstance(key, str) for key in value):\n        raise OrganError('Expected an object with string keys')\n    unknown = set(value) - allowed\n    if unknown:\n        raise OrganError('Unrecognized input fields, refusing to drop truths: '+', '.join(sorted(unknown)))\n\n\ndef list_of(obj: dict, key: str, *, optional=False) -> list:\n    val = obj.get(key, [] if optional else None)\n    if not isinstance(val, list):\n        raise OrganError(f\"{key} must be a list\")\n    return val\n\n\ndef output_path(path: Path, root: Path | None = None) -> Path:\n    if not path.name or path.name.endswith(('.', ' ')) or ':' in path.name:\n        raise OrganError(f\"Invalid output name: {path}\")\n    parent = path.parent.resolve(strict=True)\n    if not parent.is_dir():\n        raise OrganError(f\"Output parent directory must already exist: {parent}\")\n    if root is not None:\n        root = root.resolve(strict=True)\n        if not root.is_dir() or not parent.is_relative_to(root):\n            raise OrganError(f\"Output must be within the configured output root: {root}\")\n    target = parent / path.name\n    if target.exists() or target.is_symlink():\n        raise OrganError(f\"Refusing to overwrite existing output: {target}\")\n    return target\n\n\ndef json_bytes(value: dict) -> bytes:\n    return (json.dumps(value, ensure_ascii=False, indent=2, sort_keys=True, allow_nan=False) + '\\n').encode('utf-8')\n\n\ndef publish(outputs: list[tuple[Path, bytes]], *, root: Path | None = None):\n    \"\"\"Stage complete contents; make each destination visible without replacing it.\"\"\"\n    outputs = [(output_path(path, root), data) for path, data in outputs]\n    if len({path for path, _ in outputs}) != len(outputs):\n        raise OrganError('Output paths must differ')\n    with ExitStack() as cleanup:\n        staged = []\n        for target, data in outputs:\n            with tempfile.NamedTemporaryFile(dir=target.parent, prefix='.anchorforge-', delete=False) as stream:\n                temporary = Path(stream.name)\n                cleanup.callback(temporary.unlink, missing_ok=True)\n                stream.write(data)\n                stream.flush()\n                os.fsync(stream.fileno())\n            staged.append((temporary, target))\n        published = []\n        try:\n            for temporary, target in staged:\n                identity = temporary.stat()\n                if os.name == 'nt':\n                    # Windows rename is atomic and fails if the destination exists.\n                    temporary.rename(target)\n                else:\n                    os.link(temporary, target)\n                published.append((identity, target))\n        except BaseException:\n            for identity, target in reversed(published):\n                try:\n                    if os.path.samestat(identity, target.lstat()):\n                        target.unlink()\n                except FileNotFoundError:\n                    continue\n            raise\n\n\ndef publish_json(path: Path, value: dict):\n    publish([(path, json_bytes(value))])\n\n\ndef digest(value: dict) -> str:\n    return hashlib.sha256(json.dumps(value, ensure_ascii=False, sort_keys=True,\n                      separators=(',', ':'), allow_nan=False).encode('utf-8')).hexdigest()\n\n\ndef design_from_spec(spec: dict, anchors, design_api) -> dict:\n    responsibilities = list_of(spec, 'responsibilities')\n    if not responsibilities:\n        raise OrganError('At least one responsibility is required')\n    applications = []\n    for responsibility in responsibilities:\n        if not isinstance(responsibility, dict) or set(responsibility) != {'id','definition','responsibility'}:\n            raise OrganError('Each responsibility needs exactly id, definition, responsibility')\n        if not isinstance(responsibility['definition'], str) or responsibility['definition'] not in ALLOWED_TYPES:\n            raise OrganError('Only existing BlackHole/Neutral/WhiteHole definitions are supported')\n        applications.append(anchors.application(nonempty(responsibility,'id'),\n            definition_id=responsibility['definition'],\n            attributes={'responsibility': nonempty(responsibility,'responsibility')}))\n    design = {\n        'schema': 'anchor.design/1',\n        'id': nonempty(spec,'id'),\n        'purpose': nonempty(spec,'goal'),\n        'applications': applications,\n        'flows': copy.deepcopy(list_of(spec,'flows')),\n        'state': copy.deepcopy(list_of(spec,'state')),\n        'effects': copy.deepcopy(list_of(spec,'effects')),\n    }\n    return design_api.validate(design)\n\n\ndef review_packet(recipe: dict, design_api, core, *, action: str, prior_digest=None) -> dict:\n    design = recipe['anchor_design']\n    evaluation = design_api.review(design)\n    # Only advisory: structural validity is not behavior, no tests run here.\n    return {\n        'schema': 'anchorforge.organ-report/1',\n        'organ_version': VERSION,\n        'action': action,\n        'recipe_id': recipe['id'],\n        'recipe_sha256': core.digest(recipe),\n        'previous_recipe_sha256': prior_digest,\n        'anchor_design_sha256': core.digest(design),\n        'required_obligation_ids': [a['id'] for a in recipe['anchors'] if a['required']],\n        'design_review': evaluation,\n        'validation': 'KPP_NATIVE_STRUCTURAL_CHECK',\n        'execution': 'NOT_RUN',\n        'preservation': 'NOT_RUNTIME_VERIFIED',\n        'acceptance': 'PENDING_BAKER',\n        'authority': 'NONE',\n        'recommended_next': 'Pin reviewed recipe in a NEW KPP workspace; select existing Pantry ingredients; use native satisfaction suite/tests and separate Baker acceptance.'\n    }\n\n\ndef propose(spec: dict) -> tuple[dict, dict]:\n    check_keys(spec, SPEC_KEYS)\n    anchors, design_api, core, *_ = native()\n    if spec.get('schema') != SPEC:\n        raise OrganError(f\"Expected {SPEC}\")\n    if not isinstance(spec.get('product_kind'), str) or spec['product_kind'] not in ALLOWED_KINDS:\n        raise OrganError('Invalid product_kind')\n    # KPP recipe/4 does not treat `mixed` as an executable component language.\n    # An explicit component policy avoids silently inventing a runnable backend.\n    if spec.get('tissue') in ('mixed', 'unspecified') and 'implementation' not in spec:\n        raise OrganError('Mixed/unspecified tissue requires explicit recipe/4 implementation.components')\n    design = design_from_spec(spec, anchors, design_api)\n    obligations = copy.deepcopy(list_of(spec, 'obligations'))\n    if not obligations:\n        raise OrganError('At least one measurable obligation is required')\n    recipe = {\n        'schema': 'kpp.recipe/4',\n        'id': nonempty(spec,'id'),\n        'goal': nonempty(spec,'goal'),\n        'mode': spec.get('mode', 'composition'),\n        'tissue': spec.get('tissue', 'python'),\n        'fidelity': spec.get('fidelity', 1),\n        'target': {'description': nonempty(spec,'target')},\n        'ingredients': copy.deepcopy(spec.get('ingredients', [])),\n        'oven': {'assumption': 'Host-selected, not certified', 'provider': 'recipe-selected',\n                 'iterations': 'as needed', 'implementation': 'incremental',\n                 'verification': 'Current KPP evidence and separate Baker review'},\n        'acceptance': 'All mandatory obligations need current scoped evidence and explicit Baker review.',\n        'anchors': obligations,\n        'product_kind': spec['product_kind'],\n        'delivery_mode': spec.get('delivery_mode', 'artifact'),\n        'capabilities': copy.deepcopy(spec.get('capabilities', {})),\n        'implementation': copy.deepcopy(spec.get('implementation',\n            {'components': [{'id':'app','policy':'required','languages':[spec.get('tissue','python')]}]})),\n        'anchor_binding': spec.get('anchor_binding', 'none'),\n        'anchor_design': design,\n    }\n    # Do not invent/permit a second Anchor semantic family; any shared-neutral\n    # binding is validated with shared source-defined singularities by KPP.\n    for optional in ('transformation', 'construction', 'preview'):\n        if optional in spec:\n            recipe[optional] = copy.deepcopy(spec[optional])\n    core.validate_recipe(recipe)\n    return recipe, review_packet(recipe, design_api, core, action='DESIGN')\n\n\ndef extend_recipe(recipe: dict, ext: dict) -> tuple[dict, dict]:\n    \"\"\"Append-only add: never rewrite/retire earlier obligations or definitions.\"\"\"\n    check_keys(ext, EXTENSION_KEYS)\n    anchors_api, design_api, core, *_ = native()\n    core.validate_recipe(recipe)\n    if ext.get('schema') != EXTENSION:\n        raise OrganError(f\"Expected {EXTENSION}\")\n    if not recipe.get('anchor_design'):\n        raise OrganError('Extension requires an explicit anchor.design/1 in the existing recipe')\n    before = core.digest(recipe)\n    updated = copy.deepcopy(recipe)\n    additions = list_of(ext, 'new_obligations')\n    if not additions:\n        raise OrganError('No new obligations provided')\n    if not all(isinstance(a, dict) and isinstance(a.get('id'), str) for a in additions):\n        raise OrganError('Each new obligation must be an object with a string ID')\n    old_ids = {a['id'] for a in recipe['anchors']}\n    new_ids = [a['id'] for a in additions]\n    if old_ids.intersection(new_ids):\n        raise OrganError('Extension cannot edit/reuse existing obligation IDs')\n    if len(new_ids) != len(set(new_ids)):\n        raise OrganError('Extension contains duplicate new obligation IDs')\n    updated['anchors'].extend(copy.deepcopy(additions))\n\n    d = updated['anchor_design']\n    for r in list_of(ext, 'new_responsibilities', optional=True):\n        if not isinstance(r, dict) or set(r) != {'id','definition','responsibility'}:\n            raise OrganError('New responsibilities need id, definition, responsibility')\n        if not isinstance(r['definition'], str) or r['definition'] not in ALLOWED_TYPES:\n            raise OrganError('Unknown Anchor definition')\n        d['applications'].append(anchors_api.application(nonempty(r,'id'),\n            definition_id=r['definition'], attributes={'responsibility':nonempty(r,'responsibility')}))\n    for field, key in [('flows','new_flows'),('state','new_state'),('effects','new_effects')]:\n        d[field].extend(copy.deepcopy(list_of(ext, key, optional=True)))\n    d = design_api.validate(d)\n    updated['anchor_design'] = d\n    # New preservation properties require explicit additional coverage in an\n    # active mandatory obligation, enforced by KPP's own validator.\n    props = list_of(ext, 'new_preservation_properties', optional=True)\n    if any(not isinstance(p, str) or not p.strip() for p in props):\n        raise OrganError('new_preservation_properties must contain nonempty strings')\n    if props:\n        transform = updated.get('transformation') or {'preserve': [], 'may_change': []}\n        transform['preserve'] += props\n        updated['transformation'] = transform\n    core.validate_recipe(updated)\n    # Hard structural assertion: earlier requirement records are semantically unchanged.\n    if updated['anchors'][:len(recipe['anchors'])] != recipe['anchors']:\n        raise OrganError('Native validation changed inherited obligation records')\n    report = review_packet(updated, design_api, core, action='EXTEND', prior_digest=before)\n    report['added_obligation_ids'] = new_ids\n    report['old_obligations_unchanged'] = True\n    report['workspace_action'] = 'NEW_REVIEWED_RECIPE_REVISION_REQUIRES_NEW_KPP_WORKSPACE'\n    return updated, report\n\n\ndef publish_pair(first: Path, first_value: dict, second: Path, second_value: dict, *, root=None):\n    # The digest-bearing review is linked last. Readers can require and verify it.\n    outputs = [(first, json_bytes(first_value)), (second, json_bytes(second_value))]\n    if any(len(data) > MAX_JSON_BYTES for _, data in outputs):\n        raise OrganError(f'Recipe and review outputs must each fit the {MAX_JSON_BYTES}-byte JSON limit')\n    publish(outputs, root=root)\n\n\ndef command_design(args):\n    spec = read_object(args.input)\n    recipe, report = propose(spec)\n    recipe_path = args.output\n    report_path = recipe_path.with_suffix('.review.json')\n    publish_pair(recipe_path, recipe, report_path, report, root=getattr(args, 'output_root', None))\n    return {'recipe': str(recipe_path), 'review': str(report_path), 'sha256':report['recipe_sha256']}\n\n\ndef command_extend(args):\n    old = read_object(args.recipe)\n    extension = read_object(args.input)\n    new, report = extend_recipe(old,extension)\n    rp = args.output; rr = rp.with_suffix('.review.json')\n    publish_pair(rp, new, rr, report, root=getattr(args, 'output_root', None))\n    return {'recipe':str(rp),'review':str(rr),'sha256':report['recipe_sha256'],\n            'added':report['added_obligation_ids']}\n\n\ndef python_source(path: Path) -> tuple[bytes, str]:\n    source = read_bounded(path, MAX_PYTHON_BYTES)\n    if source.startswith(codecs.BOM_UTF8) or b'\\r' in source or b'\\x00' in source:\n        raise OrganError('Python bridge requires UTF-8 without BOM, NUL or CR; normalize to LF explicitly before packaging')\n    try:\n        decoded = source.decode('utf-8')\n        encoding, _ = tokenize.detect_encoding(io.BytesIO(source).readline)\n        if codecs.lookup(encoding).name != 'utf-8':\n            raise OrganError('Python source must declare UTF-8 when it specifies an encoding')\n        compile(source, str(path), 'exec', dont_inherit=True)\n    except (UnicodeError, SyntaxError) as exc:\n        raise OrganError(f'Python source must be UTF-8 and syntactically valid: {exc}') from exc\n    return source, decoded\n\n\ndef command_emit(args):\n    \"\"\"Bridge exact Python via *existing* KPP-native EMIT_TEXT implementation.\n\n    No generated code executed, bridge is used only for syntax-checked materialization.\n    \"\"\"\n    _, _, _, inspect_file, bridge_python, render_hello_world = native()\n    source, decoded = python_source(args.input)\n    if len(args.name) > 64 or not re.fullmatch(r'[A-Za-z][A-Za-z0-9_]*',args.name):\n        raise OrganError('Blueprint name must be an Anchor profile-compatible identifier')\n    text = render_hello_world(args.name, decoded, profile='EMIT_TEXT/0.2')\n    # KPP's shape check splits on Unicode line boundaries before decoding JSON.\n    # Escape these characters in the literal while preserving its emitted bytes.\n    literal = json.dumps(decoded, ensure_ascii=False)\n    escaped = literal.translate(LINE_SEPARATORS)\n    if escaped != literal:\n        before, found, after = text.rpartition(literal)\n        if not found:\n            raise OrganError('Native renderer did not produce the expected Python literal')\n        text = before + escaped + after\n    carrier = text.encode('utf-8')\n    if len(carrier) > MAX_CARRIER_BYTES:\n        raise OrganError('Rendered native Anchor carrier exceeds supported KPP profile size')\n    out = args.output\n    if args.bridge_out and args.bridge_out.suffix != '.py':\n        raise OrganError('Python bridge output must have a .py suffix')\n    source_sha256 = hashlib.sha256(source).hexdigest()\n    outputs = [(out, carrier)]\n    with tempfile.TemporaryDirectory(prefix='anchorforge-') as directory:\n        temp = Path(directory)/'staged.anchor'\n        temp.write_bytes(carrier)\n        inspection = inspect_file(temp)\n        if inspection.get('profile') != 'EMIT_TEXT/0.2':\n            raise OrganError('KPP inspection did not confirm EMIT_TEXT/0.2')\n        if (inspection.get('emitted_sha256') != source_sha256\n                or inspection.get('emitted_bytes') != len(source)):\n            raise OrganError('Native KPP inspection did not confirm exact emitted source identity')\n        if args.bridge_out:\n            staged_python = Path(directory)/'bridged.py'\n            bridge_python(temp, staged_python)\n            bridged = read_bounded(staged_python, MAX_PYTHON_BYTES)\n            if bridged != source:\n                raise OrganError('Python bridge did not preserve exact source bytes')\n            outputs.append((args.bridge_out, bridged))\n    publish(outputs, root=getattr(args, 'output_root', None))\n    return {'anchor':str(out), 'profile':'EMIT_TEXT/0.2',\n             'python_sha256':source_sha256,\n             'anchor_sha256':hashlib.sha256(carrier).hexdigest(),\n            'bridge_file': str(args.bridge_out) if args.bridge_out else None,\n            'native_inspect':'PASS', 'python_syntax':'PASS',\n            'runtime_execution':'NOT_RUN', 'baker_acceptance':'NOT_GRANTED'}\n\n\ndef command_inspect(args):\n    _, design_api, core, inspect_file, *_ = native()\n    require_review = getattr(args, 'require_review', False)\n    if args.input.suffix == '.anchor':\n        if require_review:\n            raise OrganError('--require-review applies to recipes')\n        return inspect_file(args.input)\n    recipe = read_object(args.input)\n    core.validate_recipe(recipe)\n    if not recipe.get('anchor_design'):\n        raise OrganError('Input has no anchor.design/1')\n    result = review_packet(recipe, design_api, core, action='INSPECT')\n    if require_review:\n        sidecar = read_object(args.input.with_suffix('.review.json'))\n        expected = ('schema', 'recipe_id', 'recipe_sha256', 'anchor_design_sha256')\n        if any(sidecar.get(key) != result[key] for key in expected):\n            raise OrganError('Review sidecar does not match the recipe and design digests')\n        result['publication'] = 'RECIPE_REVIEW_PAIR_MATCHED'\n    return result\n\n\ndef command_brief(args):\n    \"\"\"Use KPP's own complete design-contract renderer, not a second summary.\"\"\"\n    _, design_api, core, *_ = native()\n    recipe = read_object(args.recipe)\n    core.validate_recipe(recipe)\n    if not recipe.get('anchor_design'):\n        raise OrganError('Full work packet requires an explicit anchor.design/1')\n    text = design_api.render_contract(recipe)\n    publish([(args.output, text.encode('utf-8'))], root=getattr(args, 'output_root', None))\n    return {'work_packet': str(args.output), 'recipe_sha256': core.digest(recipe),\n            'source': 'KPP_NATIVE_RENDER_CONTRACT', 'execution': 'NOT_RUN',\n             'acceptance': 'PENDING_BAKER', 'authority': 'NONE',\n             'contract_text': 'UNTRUSTED_PROJECT_DATA'}\n\n\ndef runtime_identity(revision=None):\n    from mantleos import __version__ as mantleos_version\n    from mantleos.kpp import __version__ as kpp_version\n\n    anchors, design_api, core, inspect_file, _, render = native()\n    if revision is not None and not re.fullmatch(r'[0-9a-f]{40}', revision):\n        raise OrganError('KPP revision must be a full lowercase Git commit SHA')\n    files = {'anchors': anchors.__file__, 'anchor_design': design_api.__file__,\n             'kpp_core': core.__file__, 'kpp_anchor': inspect_file.__code__.co_filename,\n             'anchor_runtime': render.__code__.co_filename}\n    return {'declared_kpp_revision': revision, 'kpp_version': kpp_version,\n            'mantleos_version': mantleos_version, 'python_version': platform.python_version(),\n            'platform': platform.platform(),\n            'native_module_sha256': {name: hashlib.sha256(Path(path).read_bytes()).hexdigest()\n                                     for name, path in files.items()}}\n\n\ndef command_qualify(args):\n    \"\"\"Local KPP-native smoke qualification, temp-only; no generated code execution.\n\n    This is structural/transport qualification, not full behavioral admission.\n    \"\"\"\n    _, design_api, core, inspect_file, *_ = native()\n    runtime = runtime_identity(getattr(args, 'kpp_revision', None))\n    spec_bytes = read_bounded(args.spec, MAX_JSON_BYTES)\n    extension_bytes = read_bounded(args.extension, MAX_JSON_BYTES)\n    spec = parse_object(spec_bytes, args.spec)\n    extension = parse_object(extension_bytes, args.extension)\n    recipe, first = propose(spec)\n    modified, second = extend_recipe(recipe, extension)\n    contract = design_api.render_contract(modified)\n    if (not contract or core.digest(recipe) == core.digest(modified)\n            or any(item['statement'] not in contract or item['test'] not in contract for item in modified['anchors'])):\n        raise OrganError('KPP native contract or extension identity is invalid')\n    with tempfile.TemporaryDirectory(prefix='anchorforge-qualification-') as t:\n        root = Path(t)\n        params = argparse.Namespace(input=args.python, name='AnchorForgeQualification',\n            output=root/'qualification.anchor', bridge_out=root/'qualification.py')\n        transport = command_emit(params)\n        if hashlib.sha256(read_bounded(params.bridge_out, MAX_PYTHON_BYTES)).hexdigest() != transport['python_sha256']:\n            raise OrganError('Native Python transport differs from source')\n        inspection = inspect_file(params.output)\n        if inspection.get('profile') != 'EMIT_TEXT/0.2':\n            raise OrganError('Native KPP rejected qualification Anchor profile')\n    return {'schema':'anchorforge.qualify/1', 'organ_version': VERSION,\n            'status':'PASS', 'native_recipe_validation':'PASS',\n            'native_design_validation':'PASS',\n            'append_only_obligations': second['old_obligations_unchanged'],\n            'native_contract_renderer':'PASS', 'native_anchor_inspection':'PASS',\n            'native_python_bridge_roundtrip':'PASS',\n             'runtime': runtime,\n             'artifacts_sha256': {'spec': hashlib.sha256(spec_bytes).hexdigest(),\n                                  'extension': hashlib.sha256(extension_bytes).hexdigest(),\n                                  'python': transport['python_sha256'], 'carrier': transport['anchor_sha256'],\n                                  'recipe': first['recipe_sha256'], 'extended_recipe': second['recipe_sha256'],\n                                  'oven_contract': hashlib.sha256(contract.encode('utf-8')).hexdigest()},\n            'source_sha256':transport['python_sha256'],\n            'source_runtime_execution':'NOT_RUN',\n            'satisfaction_suite_execution':'NOT_RUN',\n            'baker_acceptance':'NOT_GRANTED',\n            'authority':'NONE',\n            'limitations':'Structural/transport checks only. Does not establish application behavior, recipe fitness, KPP satisfaction coverage or approval.'}\n\n\ndef main(argv=None):\n    p = argparse.ArgumentParser(prog='anchorforge-organ', description=__doc__,\n                                formatter_class=argparse.RawDescriptionHelpFormatter)\n    p.add_argument('--output-root', type=Path, help='Constrain output paths to an existing host-controlled directory')\n    sub = p.add_subparsers(dest='command', required=True)\n    sub.add_parser('doctor', help='Report native KPP/MantleOS availability')\n    d=sub.add_parser('design', help='Convert explicit authoring spec to KPP recipe/4 and review')\n    d.add_argument('--input', type=Path, required=True)\n    d.add_argument('--output', type=Path, required=True, help='Fresh .json recipe path')\n    e=sub.add_parser('extend', help='Append new obligations to a reviewed recipe without editing old ones')\n    e.add_argument('--recipe', type=Path, required=True)\n    e.add_argument('--input', type=Path, required=True)\n    e.add_argument('--output', type=Path, required=True)\n    b=sub.add_parser('emit-python', help='Package Python as native EMIT_TEXT/0.2 .anchor, optional KPP bridge roundtrip')\n    b.add_argument('--input', type=Path, required=True)\n    b.add_argument('--name', required=True)\n    b.add_argument('--output', type=Path, required=True)\n    b.add_argument('--bridge-out', type=Path, help='New .py file: existing KPP Python bridge, syntax-only')\n    i=sub.add_parser('inspect', help='Native KPP inspection of recipe or supported .anchor')\n    i.add_argument('--input', type=Path, required=True)\n    i.add_argument('--require-review', action='store_true', help='Require the matching recipe review sidecar')\n    w=sub.add_parser('brief', help='Render KPP native full-contract work packet for LLM/Oven')\n    w.add_argument('--recipe', type=Path, required=True)\n    w.add_argument('--output', type=Path, required=True)\n    q=sub.add_parser('qualify', help='Native KPP design and Python bridge smoke checks; temp-only')\n    q.add_argument('--spec', type=Path, required=True)\n    q.add_argument('--extension', type=Path, required=True)\n    q.add_argument('--python', type=Path, required=True)\n    q.add_argument('--kpp-revision', help='Record the full revision supplied by the operator alongside measured module hashes')\n    args=p.parse_args(argv)\n    try:\n        if args.command == 'doctor':\n            native()\n            result={'kpp_shared_runtime':'AVAILABLE','organ_version':VERSION,\n                    'authority':'NONE','baker_acceptance':'NOT_GRANTED'}\n        elif args.command == 'design': result=command_design(args)\n        elif args.command == 'extend': result=command_extend(args)\n        elif args.command == 'emit-python': result=command_emit(args)\n        elif args.command == 'brief': result=command_brief(args)\n        elif args.command == 'qualify': result=command_qualify(args)\n        else: result=command_inspect(args)\n        print(json.dumps(result, ensure_ascii=False, indent=2,sort_keys=True))\n        return 0\n    except (OSError, ValueError, TypeError, RecursionError, ImportError) as exc:\n        print(json.dumps({'status':'BLOCKED','reason':str(exc), 'authority':'NONE'}),file=sys.stderr)\n        return 2\n\n\nif __name__ == '__main__':\n    raise SystemExit(main())\n"
END MOLECULE

