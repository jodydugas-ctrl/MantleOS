FROM python:3.12.11-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1
WORKDIR /workspace

COPY requirements-certification.txt pyproject.toml README.md LICENSE ./
COPY src ./src
RUN python -m pip install --no-cache-dir pip==25.1.1 \
    && python -m pip install --no-cache-dir -r requirements-certification.txt \
    && python -m pip install --no-cache-dir -e .

COPY . .
CMD ["python", "-m", "mantle", "check", "--strict"]
