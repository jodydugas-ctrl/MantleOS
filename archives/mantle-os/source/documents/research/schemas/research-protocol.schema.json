{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mantle-os.local/schemas/research-protocol.schema.json",
  "title": "Mantle bounded research protocol",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_id", "protocol_version", "target_kind", "grimoire_profile", "mutable_surface", "immutable_surface", "budget", "network", "adoption_allowed"],
  "properties": {
    "protocol_id": {"const": "mantle-research-loop"},
    "protocol_version": {"const": "1"},
    "target_kind": {"enum": ["grimoire", "vcw", "mind-context", "skill", "genome", "graft", "source"]},
    "grimoire_profile": {"const": "grimoire-v0.10"},
    "mutable_surface": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "immutable_surface": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "protocol_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "evaluator_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "corpus_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "budget": {
      "type": "object", "additionalProperties": false,
      "required": ["max_experiments", "wall_seconds_each", "cpu_seconds_each", "memory_bytes_each", "max_output_bytes", "energy_floor"],
      "properties": {
        "max_experiments": {"type": "integer", "minimum": 1},
        "wall_seconds_each": {"type": "number", "exclusiveMinimum": 0},
        "cpu_seconds_each": {"type": "integer", "minimum": 1},
        "memory_bytes_each": {"type": "integer", "minimum": 1},
        "max_output_bytes": {"type": "integer", "minimum": 1},
        "file_count": {"type": "integer", "minimum": 1},
        "energy_floor": {"type": "number", "minimum": 0}
      }
    },
    "network": {"const": false},
    "adoption_allowed": {"const": false}
  }
}
