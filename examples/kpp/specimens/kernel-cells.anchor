BEGIN MOLECULE KernelCells
A: Neutral -01 -00 -text="\"\"\"Portable demonstration of the actual MantleOS kernel CELL contract.\nEmbedded trusted source is data until this Python file is explicitly executed.\n\"\"\"\nimport argparse\nimport json\nimport sys\nimport types\n\nSOURCES = {'json_contract': '\"\"\"Bounded, duplicate-safe JSON contracts and identifiers; no interpreter.\"\"\"\\nimport hashlib\\nimport json\\nimport re\\n\\nLIMIT = 1_000_000\\n\\n\\nclass Error(ValueError):\\n    pass\\n\\n\\ndef require(ok, message):\\n    if not ok:\\n        raise Error(message)\\n\\n\\ndef canonical(value, limit=LIMIT):\\n    try:\\n        encoded = json.dumps(value, ensure_ascii=False, sort_keys=True, separators=(\",\", \":\"), allow_nan=False)\\n        require(len(encoded.encode(\"utf-8\")) <= limit, \"JSON size limit exceeded\")\\n        return encoded\\n    except (TypeError, RecursionError, UnicodeError) as exc:\\n        raise Error(\"invalid JSON value\") from exc\\n\\n\\ndef digest(value):\\n    return hashlib.sha256(canonical(value).encode(\"utf-8\")).hexdigest()\\n\\n\\ndef loads(text):\\n    def pairs(items):\\n        result = {}\\n        for key, value in items:\\n            require(key not in result, \"duplicate JSON key\")\\n            result[key] = value\\n        return result\\n    try:\\n        result = json.loads(text, object_pairs_hook=pairs, parse_constant=lambda x: (_ for _ in ()).throw(Error(\"nonfinite JSON\")))\\n        canonical(result)\\n        return result\\n    except (ValueError, RecursionError) as exc:\\n        raise Error(str(exc)) from exc\\n\\n\\ndef shape(value, keys):\\n    require(type(value) is dict and set(value) == set(keys), \"unexpected fields: expected \" + \", \".join(sorted(keys)))\\n\\n\\ndef identifier(value):\\n    require(type(value) is str and re.fullmatch(r\"[A-Za-z][A-Za-z0-9_.-]{0,95}\", value), \"invalid identifier\")\\n    return value\\n\\n\\ndef text(value, maximum=4096, blank=False):\\n    require(type(value) is str and (blank or bool(value.strip())) and len(value.encode(\"utf-8\")) <= maximum, \"invalid or oversized text\")\\n    return value\\n\\n\\n', 'cells': '\"\"\"Kernel-produced CELLs: the smallest unit of an organism for that kernel.\\n\\nPixel and append-segment representations share the CELL concept; their values\\nand units remain kernel-specific. Programs compose these units but are not CELLs.\\n\"\"\"\\nfrom copy import deepcopy\\nfrom . import json_contract as contract\\n\\nSCHEMA = \\'mantle.cell/2\\'\\nKERNELS = {\\'chroma.rgb/1\\': \\'pixel\\', \\'tape.segment/1\\': \\'appended-record\\'}\\n\\n\\ndef produce(kernel, payload):\\n    value = dict(schema=SCHEMA, kernel=kernel, payload=deepcopy(payload))\\n    value[\\'sha256\\'] = contract.digest(value)\\n    return validate(value)\\n\\n\\ndef validate(value):\\n    contract.shape(value, {\\'schema\\', \\'kernel\\', \\'payload\\', \\'sha256\\'})\\n    contract.require(value[\\'schema\\'] == SCHEMA, \\'Unsupported CELL version\\')\\n    contract.require(value[\\'kernel\\'] in KERNELS, \\'Unsupported CELL kernel\\')\\n    payload = value[\\'payload\\']\\n    if value[\\'kernel\\'] == \\'chroma.rgb/1\\':\\n        contract.require(type(payload) is list and len(payload) == 3 and\\n                         all(type(v) is int and 0 <= v <= 255 for v in payload),\\n                         \\'An RGB CELL is exactly one three-channel pixel\\')\\n    else:\\n        contract.shape(payload, {\\'sequence\\', \\'record\\'})\\n        contract.require(type(payload[\\'sequence\\']) is int and payload[\\'sequence\\'] >= 1 and\\n                         type(payload[\\'record\\']) is dict, \\'A tape CELL is one append segment\\')\\n        contract.require(payload[\\'record\\'].get(\\'seq\\') == payload[\\'sequence\\'], \\'Tape CELL sequence mismatch\\')\\n    contract.require(value[\\'sha256\\'] == contract.digest({k: v for k, v in value.items() if k != \\'sha256\\'}),\\n                     \\'CELL digest mismatch\\')\\n    return deepcopy(value)\\n\\n\\ndef rgb_tape(data):\\n    \"\"\"Validate the producer\\'s byte framing without materializing millions of objects.\"\"\"\\n    contract.require(isinstance(data, (bytes, bytearray)) and len(data) % 3 == 0,\\n                     \\'RGB kernel output must contain complete pixel CELLs\\')\\n    return data\\n\\n\\ndef pixels(data):\\n    rgb_tape(data)\\n    for offset in range(0, len(data), 3):\\n        yield produce(\\'chroma.rgb/1\\', list(data[offset:offset + 3]))\\n\\n\\ndef append_segment(record):\\n    contract.require(type(record) is dict and \\'seq\\' in record, \\'Append record needs its sequence\\')\\n    return produce(\\'tape.segment/1\\', {\\'sequence\\': record[\\'seq\\'], \\'record\\': record})\\n'}\npackage = types.ModuleType('_cell_specimen')\npackage.__path__ = []\nsys.modules[package.__name__] = package\nfor name, source in SOURCES.items():\n    module = types.ModuleType(package.__name__ + '.' + name)\n    module.__package__ = package.__name__\n    sys.modules[module.__name__] = module\n    setattr(package, name, module)\n    exec(compile(source, '<canonical ' + name + '>', 'exec'), module.__dict__)\n\ndef main():\n    parser = argparse.ArgumentParser()\n    parser.add_argument('--kernel', choices=('pixel', 'tape', 'chroma.rgb/1', 'tape.segment/1'), required=True)\n    parser.add_argument('--value', required=True)\n    args = parser.parse_args()\n    value = json.loads(args.value)\n    kernel = {'pixel': 'chroma.rgb/1', 'tape': 'tape.segment/1'}.get(args.kernel, args.kernel)\n    if args.kernel == 'tape':\n        value = {'sequence': 1, 'record': {'seq': 1, 'text': value}}\n    print(json.dumps(package.cells.produce(kernel, value), sort_keys=True))\n\nif __name__ == \"__main__\":\n    main()\n"
END MOLECULE

